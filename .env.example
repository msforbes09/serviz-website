# Absolute public origin. Drives metadataBase, canonical URLs, sitemap and
# JSON-LD. No trailing slash needed — lib/env.ts strips it.
#
# Optional on Vercel: when unset, lib/env.ts falls back to the project's
# production domain, which Vercel injects into every build. Set it explicitly
# once a custom domain is in front of the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand name used in titles and structured data.
NEXT_PUBLIC_SITE_NAME=SERBIZ
